{
  "name": "whale-club",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "description": "A habit game where nothing dies. Show up, the scene fills, collectibles unlock.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "icons": "node scripts/icons.mjs",
    "shots": "node scripts/shots.mjs && node scripts/squeeze.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
